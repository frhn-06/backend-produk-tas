  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "example": "farhan"
          },
          "userName": {
            "type": "string",
            "example": "aan"
          },
          "email": {
            "type": "string",
            "example": "farhan@gmail.com"
          },
          "password": {
            "type": "string",
            "example": "psswrd"
          },
          "confirmPassword": {
            "type": "string",
            "example": "psswrd"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "aan"
          },
          "password": {
            "type": "string",
            "example": "psswrd"
          }
        }
      },
      "Activation": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "1234"
          }
        }
      },
      "RemoveImage": {
        "type": "object",
        "properties": {
          "fileUrl": {
            "type": "string",
            "example": "https://cloudinary......./foto.jpg"
          }
        }
      },
      "CategoryRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "category 1"
          },
          "icon": {
            "type": "string",
            "example": "category.jpg"
          },
          "description": {
            "type": "string",
            "example": "this is description of category 1"
          }
        }
      }
    }
