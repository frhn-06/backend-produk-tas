          },
          "password": {
            "type": "string",
            "example": "psswrd"
          },
          "confirmPassword": {
            "type": "string",
            "example": "psswrd"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "identifier": {
            "type": "string",
            "example": "aan"
          },
          "password": {
            "type": "string",
            "example": "psswrd"
          }
        }
      },
      "Activation": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "1234"
          }
        }
      },
      "RemoveImage": {
        "type": "object",
        "properties": {
